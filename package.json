{
  "name": "valdris-sdlc-harness",
  "version": "0.8.0",
  "private": true,
  "description": "Valdris SDLC Harness: commissioning, project adapters, proof gates, and workflow telemetry for Claude Code/Codex/Hermes.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "commission": "node scripts/commission-harness.mjs",
    "commission:questions": "node scripts/commission-harness.mjs --print-questions",
    "simulate:agent": "node scripts/simulate-agent-run.mjs",
    "verify:harness": "node scripts/verify-harness.mjs",
    "verify:bridge-security": "node scripts/verify-bridge-security.mjs",
    "verify:bridge-lease": "node scripts/verify-bridge-lease.mjs",
    "verify:bridge-proxy": "node --no-warnings scripts/verify-bridge-proxy.mjs",
    "verify:runtime-closure": "node scripts/verify-runtime-closure.mjs",
    "code-intelligence:scan": "node scripts/code-intelligence-scan.mjs --provider gitnexus --fallback local",
    "code-intelligence:scan:strict": "node scripts/code-intelligence-scan.mjs --provider gitnexus --fallback none --strict",
    "code-intelligence:gate": "node scripts/code-intelligence-gate-all.mjs --repo .",
    "knowledge:gate": "node scripts/okf-vault-gate.mjs --repo .",
    "catalog:gate": "node scripts/catalog-integrity-gate.mjs --repo .",
    "provenance:gate": "node scripts/provenance-gate.mjs --repo .",
    "neutrality:gate": "node scripts/neutrality-gate.mjs --repo .",
    "privacy:gate": "node scripts/privacy-gate.mjs --repo .",
    "privacy:release": "node scripts/privacy-gate.mjs --repo . --release-artifact .next",
    "schema:compat:gate": "node scripts/schema-compat-gate.mjs --repo .",
    "skills:gate": "node scripts/skill-registry-gate.mjs --repo .",
    "skills:install:codex": "node scripts/install-codex-skills.mjs",
    "skills:check:codex": "node scripts/install-codex-skills.mjs --check",
    "intake:gate": "node scripts/intake-gate.mjs --repo .",
    "route:gate": "node scripts/route-gate.mjs --repo .",
    "route:request": "node scripts/route-request.mjs",
    "classification:gate": "node scripts/workload-classification-gate.mjs --repo .",
    "foundation:gate": "node scripts/foundation-gate.mjs --repo .",
    "goal:gate": "node scripts/goal-gate.mjs --repo .",
    "goal:transition": "node scripts/goal-transition.mjs",
    "context:gate": "node scripts/context-manifest-gate.mjs --repo .",
    "production:gate": "node scripts/production-layer-gate.mjs --repo .",
    "ai:gate": "node scripts/ai-assurance-gate.mjs --repo .",
    "domain:gate": "node scripts/domain-assurance-gate.mjs --repo .",
    "eval:gate": "node scripts/eval-gate.mjs --repo .",
    "trajectory:gate": "node scripts/trajectory-gate.mjs --repo .",
    "smoke:gate": "node scripts/smoke-gate.mjs --repo .",
    "waiver:gate": "node scripts/waiver-gate.mjs --repo .",
    "run:packet:gate": "node scripts/run-packet-gate.mjs --repo .",
    "proof:run": "node scripts/proof-runner.mjs",
    "rca:gate": "node scripts/rca-gate.mjs --repo .",
    "review:gate": "node scripts/review-gate.mjs --repo .",
    "enterprise-ai:gate": "node scripts/enterprise-ai-gate-all.mjs --repo .",
    "verify:enterprise-ai": "node scripts/verify-enterprise-ai.mjs",
    "verify:import-boundaries": "node scripts/verify-import-boundaries.mjs",
    "verify:release-privacy": "node scripts/verify-release-artifact-privacy.mjs",
    "verify:assurance-overlay": "node scripts/verify-assurance-overlay.mjs",
    "verify:portable-execution": "node scripts/verify-portable-execution.mjs",
    "verify:proof-security": "node scripts/verify-proof-runner-security.mjs",
    "verify:run-packet-trust": "node scripts/verify-run-packet-trust.mjs",
    "verify:commissioned-portability": "node scripts/verify-commissioned-portability.mjs",
    "verify:generated-ci-acceptance": "node scripts/verify-commissioned-portability.mjs --acceptance-only",
    "verify:work-harness-import": "node scripts/verify-work-harness-import.mjs",
    "render:readme-visuals": "node scripts/render-readme-visuals.mjs",
    "bridge:claude": "node scripts/claude-code-bridge.mjs",
    "bridge:emit": "node scripts/uash-emit-event.mjs",
    "proof:write": "node scripts/uash-write-proof.mjs"
  },
  "dependencies": {
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
