        "operate",
        "evolve"
      ],
      "applicability": {
        "anyChangedPath": [
          "**/infra/**",
          "**/runbooks/**",
          "**/workers/**",
          "**/queues/**"
        ]
      },
      "failurePolicy": "block-stage",
      "requiredEvidence": {
        "static": [
          "incident-runbook"
        ],
        "recovery": [
          "recovery-drill",
          "operator-replay-exercise"
        ]
      }
    }
  ]
}
